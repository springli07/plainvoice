# Optional. No key is needed for local analysis or the web workbench.
# Export these variables in your shell. PlainVoice does not auto-load .env files.
PLAINVOICE_BACKEND=openai
PLAINVOICE_MODEL=
PLAINVOICE_BASE_URL=https://api.openai.com/v1
PLAINVOICE_API_KEY=
# For local generation, set PLAINVOICE_BACKEND=local and use a cached model path.
